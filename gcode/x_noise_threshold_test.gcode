; ============================================
; X Axis Noise Threshold Test - Klipper Compatible
; Bed: 350x350, Y fixed at center Y175
; X range: 25 <-> 325 (300mm run -- long enough to cruise at full speed)
; Accel: 5000 mm/s^2
; Speeds: 200 -> 350 mm/s in fine steps around the noise transition
; 4 passes per speed -- listen for when X goes from whisper to audible
; No filament needed - motion test only
; ============================================

G28
G90
G1 Z5 F300
SET_VELOCITY_LIMIT ACCEL=5000 VELOCITY=350
G1 X175 Y175 F6000
TFT_NOTIFY MSG="X Noise Test Starting"

; ============================================
; 200 mm/s = F12000 -- baseline quiet
; ============================================
TFT_NOTIFY MSG="200 mm/s"
G1 X25  Y175 F12000
G1 X325 Y175 F12000
G1 X25  Y175 F12000
G1 X325 Y175 F12000

; ============================================
; 225 mm/s = F13500
; ============================================
TFT_NOTIFY MSG="225 mm/s"
G1 X25  Y175 F13500
G1 X325 Y175 F13500
G1 X25  Y175 F13500
G1 X325 Y175 F13500

; ============================================
; 250 mm/s = F15000
; ============================================
TFT_NOTIFY MSG="250 mm/s"
G1 X25  Y175 F15000
G1 X325 Y175 F15000
G1 X25  Y175 F15000
G1 X325 Y175 F15000

; ============================================
; 265 mm/s = F15900
; ============================================
TFT_NOTIFY MSG="265 mm/s"
G1 X25  Y175 F15900
G1 X325 Y175 F15900
G1 X25  Y175 F15900
G1 X325 Y175 F15900

; ============================================
; 275 mm/s = F16500
; ============================================
TFT_NOTIFY MSG="275 mm/s"
G1 X25  Y175 F16500
G1 X325 Y175 F16500
G1 X25  Y175 F16500
G1 X325 Y175 F16500

; ============================================
; 285 mm/s = F17100
; ============================================
TFT_NOTIFY MSG="285 mm/s"
G1 X25  Y175 F17100
G1 X325 Y175 F17100
G1 X25  Y175 F17100
G1 X325 Y175 F17100

; ============================================
; 295 mm/s = F17700
; ============================================
TFT_NOTIFY MSG="295 mm/s"
G1 X25  Y175 F17700
G1 X325 Y175 F17700
G1 X25  Y175 F17700
G1 X325 Y175 F17700

; ============================================
; 300 mm/s = F18000
; ============================================
TFT_NOTIFY MSG="300 mm/s"
G1 X25  Y175 F18000
G1 X325 Y175 F18000
G1 X25  Y175 F18000
G1 X325 Y175 F18000

; ============================================
; 310 mm/s = F18600
; ============================================
TFT_NOTIFY MSG="310 mm/s"
G1 X25  Y175 F18600
G1 X325 Y175 F18600
G1 X25  Y175 F18600
G1 X325 Y175 F18600

; ============================================
; 320 mm/s = F19200
; ============================================
TFT_NOTIFY MSG="320 mm/s"
G1 X25  Y175 F19200
G1 X325 Y175 F19200
G1 X25  Y175 F19200
G1 X325 Y175 F19200

; ============================================
; 330 mm/s = F19800
; ============================================
TFT_NOTIFY MSG="330 mm/s"
G1 X25  Y175 F19800
G1 X325 Y175 F19800
G1 X25  Y175 F19800
G1 X325 Y175 F19800

; ============================================
; 340 mm/s = F20400
; ============================================
TFT_NOTIFY MSG="340 mm/s"
G1 X25  Y175 F20400
G1 X325 Y175 F20400
G1 X25  Y175 F20400
G1 X325 Y175 F20400

; ============================================
; 350 mm/s = F21000
; ============================================
TFT_NOTIFY MSG="350 mm/s"
G1 X25  Y175 F21000
G1 X325 Y175 F21000
G1 X25  Y175 F21000
G1 X325 Y175 F21000

; ============================================
; Done -- restore defaults
; ============================================
SET_VELOCITY_LIMIT ACCEL=500 VELOCITY=300
G1 X175 Y175 F6000
G1 Z50 F300
TFT_NOTIFY MSG="X Noise Test Complete"
